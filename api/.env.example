# Server
PORT=4000
NODE_ENV=development

# Database (local Postgres)
DATABASE_URL=postgres://localhost:5432/tecim_api

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Optional — Redis (Upstash). Falls back to in-memory store when absent.
REDIS_URL=

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional — site revalidation on publish
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=

# Optional — Cloudinary (media library). Uploads fail gracefully when absent.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tecim/site

# Optional — SendGrid (OTP emails for forgot-password). Emails are logged when absent.
SENDGRID_API_KEY=
FROM_EMAIL=

# Seed admin (used by npm run seed)
ADMIN_EMAIL=admin@tecim.org
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Site Admin
